# Скопируйте этот файл в .env и впишите свои значения
# Переменные, заданные в окружении ОС, имеют приоритет над .env

DEV_LOGIN=admin
DEV_PASWORD=change-me-min-12-symbols

# Приложение всегда слушает порт 3000 (PORT задавать не нужно).
# Необязательные:
# WEB_PORT=40781   внешний порт, на который docker compose пробросит 3000
# HOST=0.0.0.0
# DATA_FILE=./data/data.json   рабочая база; по умолчанию data/data.json рядом с проектом
#                                       (папка data не попадает в git — данные переживают обновления)
# NODE_ENV=production
