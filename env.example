# Скопируйте этот файл в .env и впишите свои значения
# Переменные, заданные в окружении ОС, имеют приоритет над .env

DEV_LOGIN=admin
DEV_PASWORD=change-me-min-12-symbols
PORT=40781

# Необязательные:
# AUTO_PORT=0     если PORT занят — взять свободный автоматически
# WEB_PORT=40781   (внешний порт для docker compose)
# HOST=0.0.0.0
# DATA_FILE=./data.json
# NODE_ENV=production
